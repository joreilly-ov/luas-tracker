# Database Configuration
# For local development with SQLite (default):
# DATABASE_URL=sqlite:///./luas_tracker.db

# For PostgreSQL (Neon / local):
# DATABASE_URL=postgresql://username:password@host/luas_tracker?sslmode=require

# CORS — defaults to * (allow all) since this is a public read-only API.
# To restrict to specific origins, set as comma-separated list:
# ALLOWED_ORIGINS=https://myapp.fly.dev,http://localhost:5173
