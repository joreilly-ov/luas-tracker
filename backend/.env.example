# Database Configuration
# For local development with SQLite (default):
# DATABASE_URL=sqlite:///./luas_tracker.db

# For PostgreSQL (Neon / local):
# DATABASE_URL=postgresql://username:password@host/luas_tracker?sslmode=require

# CORS — comma-separated list of allowed origins for local development.
# Not needed in production (frontend is served from the same origin as the API).
# ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
