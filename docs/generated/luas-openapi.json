    "/dart/arrivals/{station_code}": {
      "get": {
        "summary": "Dart Arrivals",
        "description": "Live DART arrivals proxy \u2014 fetches directly from the Irish Rail real-time API\nand returns only DART services (filters out Intercity / Commuter).\nNo database is used; this is a pure passthrough.\n\nhas_any_service is True if either the requested station or (when it shows\nno trains) the Connolly hub station has trains in the 90-minute window.\nThis prevents false disruption warnings at quieter stations that simply\nhave a gap in their schedule.",
        "operationId": "dart_arrivals_dart_arrivals__station_code__get",
        "parameters": [
          {
            "name": "station_code",
            "in": "path",
            "required": true,
