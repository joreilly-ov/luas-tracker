    "/accuracy/calculate": {
      "post": {
        "summary": "Calculate Accuracy",
        "description": "Calculate forecast accuracy by comparing forecasts across polls.\n\nAlgorithm:\n1. For each unique tram (destination + direction)\n2. Look at forecasts from previous polls\n3. When a tram \"arrives\" (forecast_arrival_minutes approaches 0)\n4. Compare original forecast to actual time taken\n5. Store accuracy delta\n\nThis runs periodically to populate LuasAccuracy table.",
        "operationId": "calculate_accuracy_accuracy_calculate_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
