# DART Tracker — environment variables
# This service is completely independent of the Luas backend.

# SQLite (default for local dev):
# DART_DATABASE_URL=sqlite:///./dart_tracker.db

# PostgreSQL (Amazon RDS — use a separate database from Luas):
# DART_DATABASE_URL=postgresql://username:password@your-instance.rds.amazonaws.com:5432/dart_tracker
